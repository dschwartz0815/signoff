{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClassifyJudgeOutput",
  "type": "object",
  "additionalProperties": false,
  "required": ["label", "explanation", "confidence"],
  "properties": {
    "label": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "excerpt": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    }
  }
}
