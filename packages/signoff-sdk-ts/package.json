{
  "name": "@signoff/sdk",
  "version": "0.0.1",
  "description": "TypeScript client for Signoff — the verification layer for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "sync-schemas": "node scripts/copy-schemas.mjs",
    "prebuild": "pnpm run sync-schemas",
    "pretest": "pnpm run sync-schemas",
    "pretypecheck": "pnpm run sync-schemas",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.0",
    "tsup": "^8.3.0",
    "typescript": "5.4.5",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dschwartz0815/signoff.git",
    "directory": "packages/signoff-sdk-ts"
  }
}
