{
  "name": "signoff-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for Signoff TypeScript packages.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@signoff/sdk": "workspace:*",
    "typescript": "5.4.5"
  }
}
